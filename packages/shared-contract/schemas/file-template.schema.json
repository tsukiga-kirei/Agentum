{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentum.local/schemas/file-template.schema.json",
  "title": "文件交付模板",
  "description": "新增文件模板与结构化结果专用契约，不改变原有文本输出和内容交付。",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "sheet": {
            "type": "string"
          },
          "style": {
            "$ref": "#/$defs/style"
          }
        },
        "required": [
          "id",
          "field",
          "label",
          "sheet",
          "style"
        ],
        "additionalProperties": false
      }
    },
    "defaultStyle": {
      "$ref": "#/$defs/style"
    },
    "sheetStyles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/style"
      }
    },
    "excelRegions": {
      "type": "array",
      "maxItems": 3000,
      "items": {
        "type": "object",
        "properties": {
          "sheet": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "startCell": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,5}$"
          },
          "direction": {
            "type": "string",
            "enum": [
              "vertical",
              "horizontal"
            ],
            "default": "vertical",
            "description": "该字段位置按原数组顺序向下或向右填写，空值不压缩"
          },
          "column": {
            "type": "string",
            "description": "该填写位置对应的明细字段标识"
          },
          "growth": {
            "type": "string",
            "enum": [
              "shift",
              "fixed"
            ],
            "default": "shift",
            "description": "推移后续整行/整列，或仅使用已有空白并在冲突时失败"
          },
          "rangeName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255,
            "description": "工作簿级动态名称，实际范围包含记录空值并排除表头和合计；留空自动生成 data_列表_字段"
          }
        },
        "required": [
          "sheet",
          "field",
          "startCell",
          "column",
          "direction"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "fields",
    "locations",
    "defaultStyle",
    "sheetStyles"
  ],
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "key",
        "label",
        "type",
        "required",
        "columns"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,79}$"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "paragraphs",
            "markdown",
            "number",
            "date",
            "boolean",
            "table"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "maxLength": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 200000
        },
        "maxItems": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100000
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "enumValues": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "maxItems": 100
        }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontSize": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "firstLineChars": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "leftIndentCm": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "lineSpacing": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "spacingBefore": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "spacingAfter": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "rowHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "columnWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        "indent": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "cellPaddingPt": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "wrapText": {
          "type": "boolean"
        },
        "border": {
          "type": "boolean"
        },
        "fontFamily": {
          "type": "string",
          "maxLength": 100
        },
        "numberFormat": {
          "type": "string",
          "maxLength": 100
        },
        "color": {
          "type": "string",
          "pattern": "^#?[0-9A-Fa-f]{6}$"
        },
        "backgroundColor": {
          "type": "string",
          "pattern": "^#?[0-9A-Fa-f]{6}$"
        },
        "alignment": {
          "enum": [
            "left",
            "center",
            "right",
            "both"
          ]
        },
        "verticalAlignment": {
          "enum": [
            "top",
            "center",
            "bottom"
          ]
        },
        "rowHeightMode": {
          "type": "string",
          "enum": [
            "auto",
            "inherit",
            "fixed"
          ],
          "description": "明细行高默认按内容适配；可沿用模板或固定磅值"
        }
      }
    },
    "binding": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "constant": {
          "type": "boolean"
        },
        "value": {},
        "sourceNodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "variable": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "columnMappings": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "field",
        "constant"
      ],
      "additionalProperties": false
    },
    "structuredOutput": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "variable": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "required": [
        "enabled",
        "variable",
        "fields"
      ],
      "additionalProperties": false
    }
  }
}
